{
  "manifest_version": 3,
  "name": "Lyrics for YouTube Music",
  "version": "0.1.0",
  "description": "Envía la pista actual de YouTube Music a Lyrics local.",
  "icons": {
    "16": "icons/lyrics-16.png",
    "32": "icons/lyrics-32.png",
    "48": "icons/lyrics-48.png",
    "128": "icons/lyrics-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Estado de Lyrics",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lyrics-16.png",
      "32": "icons/lyrics-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
